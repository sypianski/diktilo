<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Sparkle reads Diktilo's own appcast, never upstream VoiceInk's.
	     Updates are EdDSA-signed; the private key is in 1Password ("Diktilo
	     Sparkle EdDSA key", vault other) and on the Mac in
	     ~/.config/diktilo/sparkle_ed_private.txt. The updater only starts in
	     `make dmg` builds (DIST_BUILD), see UpdaterViewModel. -->
	<key>LSUIElement</key>
	<false/>
	<key>SUFeedURL</key>
	<string>https://sypian.ski/diktilo/appcast.xml</string>
	<key>SUPublicEDKey</key>
	<string>4U0FLw6/bOTvyeA8cWqaj4iiWt0yO6q0kqeTCFq0UUY=</string>
	<key>SUEnableAutomaticChecks</key>
	<true/>
	<key>NSMicrophoneUsageDescription</key>
	<string>Diktilo needs access to your microphone to record audio for transcription.</string>
	<key>NSAppleEventsUsageDescription</key>
	<string>Diktilo needs to interact with your browser to detect the current website for applying website-specific configurations.</string>
	<key>NSScreenCaptureUsageDescription</key>
	<string>Diktilo needs screen recording access to understand context from your screen for improved transcription accuracy.</string>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<true/>
	</dict>
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Audio/Video File</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>public.audio</string>
				<string>public.movie</string>
			</array>
			<key>CFBundleTypeExtensions</key>
			<array>
				<string>wav</string>
				<string>mp3</string>
				<string>m4a</string>
				<string>aiff</string>
				<string>mp4</string>
				<string>mov</string>
				<string>aac</string>
				<string>flac</string>
				<string>caf</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
