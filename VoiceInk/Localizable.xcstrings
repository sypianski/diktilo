            "state": "translated",
            "value": "Enganxat i copiat"
          }
        }
      }
    },
    "Your text is inserted at the cursor and kept on the clipboard for your clipboard history.": {
      "comment": "Getting-started step detail.",
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tekst zostaje wstawiony w miejscu kursora i zachowany w schowku, w historii schowka."
          }
        },
        "eo": {
          "stringUnit": {
            "state": "translated",
            "value": "Via teksto estas enmetita ĉe la kursoro kaj konservita en la tondujo, por via tondujhistorio."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "El text s'insereix a la posició del cursor i es manté al porta-retalls per a l'historial del porta-retalls."
          }
        }
      }
    },
