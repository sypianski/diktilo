    "Used where Diktilo addresses you in Polish.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wird verwendet, wenn Diktilo dich auf Polnisch anspricht."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用于 Diktilo 以波兰语称呼你的地方。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dotyczy zwrotów, w których Diktilo zwraca się do Ciebie, np. „zaoszczędziłeś / zaoszczędziłaś / zaoszczędziłoś”."
          }
        },
        "eo": {
          "stringUnit": {
            "state": "translated",
            "value": "Uzata, kie Diktilo alparolas vin pole."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "S'aplica quan Diktilo s'adreça a tu en polonès."
          }
        }
      }
    },
    "While you record, this bar appears %@. The round button on the left finishes, %@. The shortcuts underneath finish the recording and send the text to a specific place.": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Podczas nagrywania ten pasek pojawia się %@. Okrągły przycisk po lewej kończy nagranie, %@. Skróty pod spodem kończą nagranie i wysyłają tekst w konkretne miejsce."
          }
        },
        "eo": {
          "stringUnit": {
            "state": "translated",
            "value": "Dum vi registras, ĉi tiu breto aperas %@. La ronda butono maldekstre finas, %@. La klavkombinoj sube finas la registradon kaj sendas la tekston al specifa loko."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
