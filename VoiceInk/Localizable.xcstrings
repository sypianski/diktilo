        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Postęp w Diktilo"
          }
        }
      }
    },
    "Diktilo reads visible screen content to improve the accuracy of transcripts.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diktilo liest sichtbare Bildschirminhalte, um die Genauigkeit der Transkripte zu verbessern."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
