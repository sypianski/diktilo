    "Diktilo sessions completed": {
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diktilo-Sitzungen abgeschlossen"
          }
        },
        "zh-Hans": {
          "stringUnit": {
