    "Diktilo is private by default. No data leaves your device unless you opt in.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diktilo ist standardmäßig privat. Keine Daten verlassen dein Gerät, sofern du dem nicht zustimmst."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Diktilo 默认保护隐私。除非你主动选择，否则任何数据都不会离开你的设备。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Diktilo jest domyślnie prywatne. Żadne dane nie opuszczają urządzenia, jeśli sam tego nie wybierzesz."
          }
        },
        "eo": {
          "stringUnit": {
