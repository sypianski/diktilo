          }
        }
      }
    },
    "Getting started": {
      "comment": "Section title for the newcomer getting-started guide on the dashboard.",
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pierwsze kroki"
          }
        },
        "eo": {
          "stringUnit": {
