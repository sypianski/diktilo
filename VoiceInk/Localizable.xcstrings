    "Diktilo is also open source, so you can inspect every single line of code.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diktilo ist auch Open Source, sodass du jede Codezeile einsehen kannst."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Diktilo 还是开源软件，你可以查看每一行代码。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Diktilo jest też open source — możesz przejrzeć każdą linię kodu."
          }
        },
        "eo": {
          "stringUnit": {
            "state": "translated",
            "value": "Diktilo estas ankaŭ malfermitkoda, do vi povas kontroli ĉiun linion de la kodo."
          }
        }
      }
    },
    "Diktilo is Context-Aware": {
