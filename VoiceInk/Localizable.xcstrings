        },
        "eo": {
          "stringUnit": {
            "state": "translated",
            "value": "Montras sub la registra breto la finajn klavkombinojn de viaj reĝimoj kaj konservceloj."
          }
        }
      }
    },
    "Show Tour": {
      "localizations": {
