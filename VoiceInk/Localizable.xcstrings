            "value": "Unuaj paŝoj"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Primers passos"
          }
        }
      }
    },
    "Set a recording shortcut": {
      "comment": "Getting-started step title.",
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ustaw skrót nagrywania"
          }
        },
        "eo": {
          "stringUnit": {
            "state": "translated",
            "value": "Agordi registran klavkombinon"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Defineix una drecera d'enregistrament"
          }
        }
      }
    },
    "Open Modes to choose the shortcut that starts and stops dictation.": {
      "comment": "Getting-started step detail.",
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Otwórz Tryby, aby wybrać skrót rozpoczynający i kończący dyktowanie."
          }
        },
        "eo": {
          "stringUnit": {
            "state": "translated",
            "value": "Malfermu Reĝimojn por elekti la klavkombinon, kiu komencas kaj ĉesigas la diktadon."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Obre Modes per triar la drecera que inicia i atura el dictat."
          }
        }
      }
    },
    "Speak, then finish": {
      "comment": "Getting-started step title.",
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Mów, a potem zakończ"
          }
        },
        "eo": {
          "stringUnit": {
            "state": "translated",
            "value": "Parolu, poste finu"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Parla i després acaba"
          }
        }
      }
    },
    "Press the shortcut, dictate, and press it again. Diktilo transcribes in the background.": {
      "comment": "Getting-started step detail.",
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Naciśnij skrót, dyktuj i naciśnij go ponownie. Diktilo transkrybuje w tle."
          }
        },
        "eo": {
          "stringUnit": {
            "state": "translated",
            "value": "Premu la klavkombinon, diktu kaj premu ĝin denove. Diktilo transskribas fone."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Prem la drecera, dicta i torna-la a prémer. Diktilo transcriu en segon pla."
          }
        }
      }
    },
    "Pasted and copied": {
      "comment": "Getting-started step title.",
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wklejone i skopiowane"
