          }
        }
      }
    },
    "Your language change will take full effect after you quit and reopen Diktilo.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Sprachänderung wird vollständig wirksam, nachdem du Diktilo beendet und erneut geöffnet hast."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "退出并重新打开 Diktilo 后，语言更改才会完全生效。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zmiana języka zacznie w pełni obowiązywać po ponownym uruchomieniu Diktilo."
          }
        },
        "eo": {
          "stringUnit": {
            "state": "translated",
            "value": "La lingvoŝanĝo plene efikos post kiam vi ĉesigos kaj remalfermos Diktilon."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "El canvi d'idioma s'aplicarà del tot quan surtis de Diktilo i el tornis a obrir."
          }
        }
      }
    },
    "Your Diktilo journey starts with your first recording.": {
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Diktilo-Reise beginnt mit der ersten Aufnahme."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的 Diktilo 之旅从第一次录音开始。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoja przygoda z Diktilo zaczyna się od pierwszego nagrania."
          }
        },
        "eo": {
          "stringUnit": {
            "state": "translated",
            "value": "Via vojaĝo kun Diktilo komenciĝas per via unua registrado."
          }
