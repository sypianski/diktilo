          }
        }
      }
    },
    "Select the text on the screen, tell Diktilo the changes you want, and Diktilo will rewrite the text for you.": {
      "extractionState": "stale",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选中屏幕上的文字，告诉 Diktilo 你想怎么改，它就会替你改写。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zaznacz tekst na ekranie, powiedz Diktilo, jakie zmiany chcesz wprowadzić, a Diktilo przepisze go za ciebie."
          }
        },
        "eo": {
          "stringUnit": {
            "state": "translated",
            "value": "Elektu tekston sur la ekrano, diru al Diktilo la deziratajn ŝanĝojn, kaj Diktilo reverkos la tekston por vi."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Selecciona el text a la pantalla, digues a Diktilo quins canvis vols i Diktilo el reescriurà per tu."
          }
        }
      }
    },
    "Share Diktilo with friends or your audience and receive %@ on every referral that upgrades.": {
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Empfiehl Diktilo Freunden oder deinem Publikum und erhalte %@ für jede geworbene Person, die ein Upgrade durchführt."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将 Diktilo 分享给朋友或你的受众，每有一位经你推荐并升级的用户，你都将获得 %@ 的分成。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Udostępnij Diktilo znajomym lub odbiorcom i otrzymaj %@ za każdą poleconą osobę, która kupi subskrypcję."
          }
        },
        "eo": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunhavigu Diktilon kun amikoj aŭ via publiko kaj ricevu %@ por ĉiu rekomendita persono, kiu aĉetas abonon."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Comparteix Diktilo amb amics o amb el teu públic i rep %@ per cada persona recomanada que es passi a la versió de pagament."
          }
        }
      }
    },
    "Start or stop the Diktilo recorder for voice transcription.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diktilo-Aufnahme für Sprachtranskription starten oder stoppen."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "启动或停止 Diktilo 录音器，以进行语音转写。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uruchom lub zatrzymaj rejestrator Diktilo do transkrypcji głosu."
          }
        },
        "eo": {
          "stringUnit": {
            "state": "translated",
            "value": "Komenci aŭ ĉesigi la registrilon de Diktilo por voĉa transskribo."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicia o atura l'enregistrador de Diktilo per a la transcripció de veu."
          }
        }
      }
    },
    "Thank you for using Diktilo": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Danke, dass du Diktilo verwendest"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "感谢你使用 Diktilo"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dziękujemy za korzystanie z Diktilo"
          }
        },
        "eo": {
          "stringUnit": {
            "state": "translated",
            "value": "Dankon pro uzado de Diktilo"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Gràcies per fer servir Diktilo"
          }
        }
      }
    },
    "The key worked, but Diktilo could not save it securely.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Schlüssel funktioniert, aber Diktilo konnte ihn nicht sicher speichern."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "密钥有效，但 Diktilo 无法安全地存储它。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Klucz zadziałał, ale Diktilo nie mogło go bezpiecznie zapisać."
          }
        },
        "eo": {
          "stringUnit": {
            "state": "translated",
            "value": "La ŝlosilo funkciis, sed Diktilo ne povis konservi ĝin sekure."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "La clau funciona, però Diktilo no l'ha pogut desar de manera segura."
          }
        }
      }
    },
    "Toggle Diktilo Recorder": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diktilo-Aufnahme umschalten"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "切换 Diktilo 录音器"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Włącz/wyłącz rejestrator Diktilo"
          }
        },
        "eo": {
          "stringUnit": {
            "state": "translated",
            "value": "Ŝalti/malŝalti la registrilon de Diktilo"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Activar/desactivar l'enregistrador de Diktilo"
          }
        }
      }
    },
    "Try a few short samples and see how Diktilo works before you start.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Probiere ein paar kurze Beispiele aus und sieh dir an, wie Diktilo funktioniert."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开始之前，先试几个简短的示例，看看 Diktilo 是如何工作的。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wypróbuj kilka krótkich próbek i sprawdź, jak działa Diktilo, zanim zaczniesz."
          }
        },
        "eo": {
          "stringUnit": {
            "state": "translated",
            "value": "Provu kelkajn mallongajn ekzemplojn kaj vidu, kiel Diktilo funkcias, antaŭ ol komenci."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Prova unes quantes mostres curtes i descobreix com funciona Diktilo abans de començar."
          }
        }
      }
    },
    "Turn your spoken note into a clean email draft with Diktilo.": {
      "extractionState": "stale",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用 Diktilo 把你的口述整理成整洁的邮件草稿。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zamień mówioną notatkę w gotowy szkic e-maila za pomocą Diktilo."
          }
        },
        "eo": {
          "stringUnit": {
            "state": "translated",
            "value": "Igu vian parolitan noton pura retpoŝta malneto per Diktilo."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Converteix una nota de veu en un esborrany de correu net amb Diktilo."
          }
        }
      }
    },
    "Use Diktilo now.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diktilo jetzt nutzen."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "立即使用 Diktilo。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Używaj Diktilo teraz."
          }
        },
        "eo": {
          "stringUnit": {
            "state": "translated",
            "value": "Uzu Diktilon nun."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Fes servir Diktilo ara."
          }
        }
      }
    },
    "Diktilo": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diktilo"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Diktilo"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Diktilo"
          }
        },
        "eo": {
          "stringUnit": {
            "state": "translated",
            "value": "Diktilo"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Diktilo"
          }
        }
      }
    },
    "Diktilo app is not available": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diktilo-App ist nicht verfügbar"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Diktilo App 不可用"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplikacja Diktilo jest niedostępna"
          }
        },
        "eo": {
          "stringUnit": {
            "state": "translated",
            "value": "La aplikaĵo Diktilo ne disponeblas"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "L'app Diktilo no està disponible"
          }
        }
      }
    },
    "Diktilo automatically understands what you are working with and selects your preferred setup. You can always configure this by editing or creating new modes.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diktilo erkennt automatisch, woran du arbeitest, und wählt deine bevorzugte Konfiguration aus. Du kannst dies jederzeit anpassen, indem du Modi bearbeitest oder neue erstellst."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Diktilo 会自动识别你正在处理的内容，并选用你偏好的设置。你随时可以通过编辑或创建新模式来进行配置。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Diktilo automatycznie rozpoznaje, nad czym pracujesz, i wybiera preferowaną konfigurację. Możesz to zawsze zmienić, edytując istniejące tryby lub tworząc nowe."
          }
        },
        "eo": {
          "stringUnit": {
            "state": "translated",
            "value": "Diktilo aŭtomate komprenas, pri kio vi laboras, kaj elektas vian preferatan agordon. Vi ĉiam povas ŝanĝi tion, redaktante ekzistantajn reĝimojn aŭ kreante novajn."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Diktilo entén automàticament amb què estàs treballant i selecciona la configuració que prefereixes. Sempre ho pots configurar editant els modes o creant-ne de nous."
          }
        }
      }
    },
    "Diktilo can select the right mode from the app you are using and the rules you configure.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diktilo kann anhand der verwendeten App und der konfigurierten Regeln den passenden Modus auswählen."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Diktilo 可以根据你正在使用的 App 和你配置的规则选择合适的模式。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Diktilo może wybrać odpowiedni tryb na podstawie używanej aplikacji i skonfigurowanych przez ciebie reguł."
          }
        },
        "eo": {
          "stringUnit": {
            "state": "translated",
            "value": "Diktilo povas elekti la ĝustan reĝimon laŭ la uzata aplikaĵo kaj la reguloj, kiujn vi agordis."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Diktilo pot seleccionar el mode adequat segons l'app que facis servir i les regles que configuris."
          }
        }
      }
    },
    "Diktilo couldn't access its storage location. Your transcriptions will not be saved between sessions.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diktilo konnte nicht auf den Speicherort zugreifen. Deine Transkriptionen werden nicht zwischen Sitzungen gespeichert."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Diktilo 无法访问其存储位置。你的转写记录将无法跨会话存储。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Diktilo nie mogło uzyskać dostępu do miejsca przechowywania. Twoje transkrypcje nie będą zapisywane między sesjami."
          }
        },
        "eo": {
          "stringUnit": {
            "state": "translated",
            "value": "Diktilo ne povis aliri sian konservejon. Viaj transskriboj ne estos konservitaj inter seancoj."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Diktilo no ha pogut accedir a la ubicació d'emmagatzematge. Les transcripcions no es desaran entre sessions."
          }
        }
      }
    },
    "Diktilo Insights": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diktilo-Einblicke"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Diktilo 使用分析"
