    "Required for Diktilo shortcuts and app-wide controls to work properly.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erforderlich für Diktilo-Tastaturkürzel und app-weite Steuerung."
