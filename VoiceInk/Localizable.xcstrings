    "Automatically delete audio recordings while keeping text transcripts intact.": {
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Audioaufnahmen automatisch löschen, während Texttranskriptionen erhalten bleiben."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自动删除音频录音，同时完整保留文字转写记录。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatycznie usuwa nagrania audio, zachowując transkrypcje tekstowe."
          }
        },
        "eo": {
          "stringUnit": {
            "state": "translated",
            "value": "Aŭtomate forigas sonregistraĵojn, konservante la tekstajn transskribojn."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Elimina automàticament els enregistraments d'àudio i conserva intactes les transcripcions de text."
          }
        }
      }
    },
    "Automatically delete transcript history based on the retention period you set.": {
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Transkriptionshistorie automatisch basierend auf dem festgelegten Aufbewahrungszeitraum löschen."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "根据你设置的保留期限自动删除转写记录。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatycznie usuwa historię transkrypcji na podstawie ustawionego okresu przechowywania."
          }
        },
        "eo": {
          "stringUnit": {
            "state": "translated",
            "value": "Aŭtomate forigas la transskriban historion laŭ la konserva periodo, kiun vi agordis."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Elimina automàticament l'historial de transcripcions segons el període de conservació que hagis definit."
          }
        }
      }
    },
    "Automatically presses a key combination after pasting text. Useful for chat applications or forms that use different send shortcuts.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Drückt nach dem Einfügen automatisch eine Tastenkombination. Nützlich für Chat-Apps oder Formulare mit abweichenden Sendekürzeln."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "粘贴文本后自动按下组合键。适用于使用不同发送快捷键的聊天 App 或表单。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatycznie naciska skrót klawiaturowy po wklejeniu tekstu. Przydatne w aplikacjach do czatowania lub formularzach używających różnych skrótów wysyłania."
          }
        },
        "eo": {
          "stringUnit": {
            "state": "translated",
            "value": "Aŭtomate premas klavkombinon post algluo de teksto. Utila por babilaj aplikaĵoj aŭ formularoj, kiuj uzas malsamajn klavkombinojn por sendi."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Prem automàticament una combinació de tecles després d'enganxar el text. És útil en apps de xat o formularis que fan servir dreceres d'enviament diferents."
          }
        }
      }
    },
    "Automatically remove configured filler words like 'uh', 'um', or 'hmm' from transcriptions. If no filler words are configured, this cleanup is skipped.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Konfigurierte Füllwörter wie „ähm“, „äh“ oder „hmm“ automatisch aus Transkriptionen entfernen. Wenn keine Füllwörter konfiguriert sind, wird diese Bereinigung übersprungen."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自动从转写中移除已配置的填充词，例如「uh」「um」或「hmm」。如果未配置任何填充词，将跳过此清理。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatycznie usuwa skonfigurowane wyrazy wypełniające, np. „yyy\", „um\" lub „hmm\", z transkrypcji. Jeśli nie skonfigurowano żadnych wyrazów wypełniających, czyszczenie jest pomijane."
          }
        },
        "eo": {
          "stringUnit": {
            "state": "translated",
            "value": "Aŭtomate forigas agorditajn plenigajn vortojn kiel „ehm“, „um“ aŭ „hmm“ el transskriboj. Se neniuj plenigaj vortoj estas agorditaj, ĉi tiu purigado estas preterlasata."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Elimina automàticament de les transcripcions les paraules de farciment configurades, com ara «eh», «em» o «hmm». Si no n'hi ha cap de configurada, aquesta neteja s'omet."
          }
        }
      }
    },
    "Automatically skip AI enhancement when the transcription has very few words. Short phrases like \"yes\", \"thank you\", or quick commands don't benefit from enhancement.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "KI-Verbesserung automatisch überspringen, wenn die Transkription sehr wenige Wörter enthält. Kurze Phrasen wie „ja“, „danke“ oder schnelle Befehle profitieren nicht von der Verbesserung."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当转写内容字数很少时，自动跳过 AI 润色。「是的」「谢谢」之类的简短用语或快速指令并不能从润色中获益。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatycznie pomija ulepszanie przez AI, gdy transkrypcja ma bardzo mało słów. Krótkie frazy, jak „tak\", „dzięki\" czy szybkie polecenia, nie korzystają z ulepszania."
          }
        },
        "eo": {
          "stringUnit": {
            "state": "translated",
            "value": "Aŭtomate preterlasas AI-plibonigon, kiam la transskribo havas tre malmultajn vortojn. Mallongaj frazoj kiel „jes“, „dankon“ aŭ rapidaj komandoj ne profitas de plibonigo."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Omet automàticament la millora amb IA quan la transcripció té molt poques paraules. Les frases curtes com «sí», «gràcies» o les ordres ràpides no es beneficien de la millora."
          }
        }
      }
    },
