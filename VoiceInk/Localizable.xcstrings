    "Diktilo is also open source, so you can inspect every single line of code.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diktilo ist auch Open Source, sodass du jede Codezeile einsehen kannst."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Diktilo 还是开源软件，你可以查看每一行代码。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Diktilo jest też open source — możesz przejrzeć każdą linię kodu."
          }
        },
        "eo": {
          "stringUnit": {
            "state": "translated",
            "value": "Diktilo estas ankaŭ malfermitkoda, do vi povas kontroli ĉiun linion de la kodo."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Diktilo també és de codi obert, així que pots revisar cada línia de codi."
          }
        }
      }
    },
    "Diktilo is Context-Aware": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diktilo erkennt den Kontext"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Diktilo 支持上下文感知"
