    "Custom Target…": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Własny cel…"
          }
        },
        "eo": {
          "stringUnit": {
            "state": "translated",
            "value": "Propra celo…"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Destinació personalitzada…"
          }
        }
      }
    },
    "Default profile is used when no specific app or website matches are found.": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryb domyślny działa, gdy żadna aplikacja ani strona nie pasuje do innego trybu."
          }
        },
        "eo": {
          "stringUnit": {
            "state": "translated",
            "value": "La defaŭlta reĝimo funkcias, kiam neniu aplikaĵo aŭ retejo kongruas kun alia reĝimo."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "El mode per defecte s'utilitza quan cap app ni lloc web no coincideix amb un altre mode."
          }
        }
      }
    },
    "Default uses simulated Cmd+V key events. AppleScript can help when custom keyboard layouts do not paste correctly. Individual modes can override this.": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Domyślnie wysyła symulowane ⌘V. AppleScript pomaga, gdy niestandardowy układ klawiatury źle wkleja. Tryby mogą to nadpisać."
          }
        },
        "eo": {
          "stringUnit": {
            "state": "translated",
            "value": "Defaŭlte sendas simulitan ⌘V. AppleScript helpas, kiam nenorma klavararanĝo malĝuste algluas. Reĝimoj povas transpasi tion."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Per omissió, se simula la combinació de tecles Cmd+V. AppleScript pot ajudar quan una disposició de teclat personalitzada no enganxa correctament. Cada mode pot canviar-ho."
          }
        }
      }
    },
    "Default: press Esc twice.": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Domyślnie: naciśnij Esc dwa razy."
          }
        },
        "eo": {
          "stringUnit": {
            "state": "translated",
            "value": "Defaŭlte: premu Esc dufoje."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Per omissió: prem Esc dues vegades."
          }
        }
      }
    },
    "Diktilo automatically switches to this mode based on the app or website you're using, or when you say a trigger word during recording.": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Diktilo samo przełącza się na ten tryb zależnie od aplikacji lub strony, w której jesteś, albo gdy podczas nagrywania powiesz słowo-wyzwalacz."
          }
        },
        "eo": {
          "stringUnit": {
            "state": "translated",
            "value": "Diktilo mem ŝanĝas al ĉi tiu reĝimo laŭ la aplikaĵo aŭ retejo, kiun vi uzas, aŭ kiam vi diras ekigan vorton dum registrado."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Diktilo canvia automàticament a aquest mode segons l'app o el lloc web que facis servir, o quan dius una paraula activadora durant l'enregistrament."
          }
        }
      }
    },
    "Diktilo temporarily uses the clipboard to paste transcription. When enabled, it restores your previous clipboard content after the selected delay.": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Diktilo na chwilę używa schowka do wklejania. Gdy włączone, po wybranym opóźnieniu przywraca poprzednią zawartość schowka."
          }
        },
        "eo": {
          "stringUnit": {
            "state": "translated",
            "value": "Diktilo provizore uzas la tondujon por alglui. Kiam ŝaltita, ĝi restarigas la antaŭan enhavon de la tondujo post la elektita prokrasto."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Diktilo fa servir temporalment el porta-retalls per enganxar la transcripció. Si està activat, restaura el contingut anterior del porta-retalls després del retard seleccionat."
          }
        }
      }
    },
    "Diktilo Tour": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przewodnik po Diktilo"
          }
        },
        "eo": {
          "stringUnit": {
            "state": "translated",
            "value": "Gvidturo tra Diktilo"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Visita guiada per Diktilo"
          }
        }
      }
    },
    "Directory": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Katalog"
          }
        },
        "eo": {
          "stringUnit": {
            "state": "translated",
            "value": "Dosierujo"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Carpeta"
          }
        }
      }
    },
    "During recording, press Option + 1–0 to switch modes quickly.": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Podczas nagrywania ⌥1–⌥0 szybko przełącza tryby."
          }
        },
        "eo": {
          "stringUnit": {
            "state": "translated",
            "value": "Dum registrado ⌥1–⌥0 rapide ŝanĝas la reĝimon."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Durant l'enregistrament, prem Opció + 1–0 per canviar de mode ràpidament."
          }
        }
      }
    },
    "Edit Save Target": {
      "localizations": {
