          }
        }
      }
    },
    "Use captured on-screen text as context for this profile.": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Użyj tekstu odczytanego z ekranu jako kontekstu dla tego trybu."
          }
        },
        "eo": {
          "stringUnit": {
            "state": "translated",
            "value": "Uzi tekston legitan de la ekrano kiel kuntekston por ĉi tiu reĝimo."
          }
        }
      }
    },
    "Use clipboard text as context for this profile.": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Użyj tekstu ze schowka jako kontekstu dla tego trybu."
          }
        },
        "eo": {
          "stringUnit": {
            "state": "translated",
            "value": "Uzi tekston el la tondujo kiel kuntekston por ĉi tiu reĝimo."
          }
        }
      }
    },
    "Use selected text from the active app as context for this profile.": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Użyj zaznaczonego tekstu z aktywnej aplikacji jako kontekstu dla tego trybu."
          }
        },
        "eo": {
          "stringUnit": {
            "state": "translated",
            "value": "Uzi elektitan tekston el la aktiva aplikaĵo kiel kuntekston por ĉi tiu reĝimo."
          }
        }
      }
    },
    "Use {{text}} or {text} as a placeholder for the transcript.": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "W miejsce transkrypcji wstaw {{text}} albo {text}."
          }
        },
        "eo": {
          "stringUnit": {
            "state": "translated",
            "value": "Anstataŭ la transskribo enmetu {{text}} aŭ {text}."
          }
        }
      }
    },
    "Utility Shortcuts": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Skróty pomocnicze"
          }
        },
        "eo": {
          "stringUnit": {
            "state": "translated",
            "value": "Helpaj klavkombinoj"
          }
        }
      }
    },
    "When off, the text is delivered silently in the background.": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wyłączone: tekst trafia na miejsce po cichu, w tle."
          }
        },
        "eo": {
          "stringUnit": {
            "state": "translated",
            "value": "Malŝaltita: la teksto estas liverata silente, fone."
          }
        }
      }
    },
    "Where the Text Goes": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dokąd trafia tekst"
          }
        },
        "eo": {
          "stringUnit": {
            "state": "translated",
            "value": "Kien iras la teksto"
          }
        }
      }
    },
    "While recording: ⌥1–⌥0 switches the mode, ⌘↩ finishes in the current mode, and a mode's finish shortcut finishes in that mode.": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Podczas nagrywania: ⌥1–⌥0 przełącza tryb, ⌘↩ kończy w bieżącym trybie, a skrót kończący trybu kończy w tym trybie."
          }
        },
        "eo": {
          "stringUnit": {
            "state": "translated",
            "value": "Dum registrado: ⌥1–⌥0 ŝanĝas la reĝimon, ⌘↩ finas en la nuna reĝimo, kaj la fina klavkombino de reĝimo finas en tiu reĝimo."
          }
        }
      }
    },
    "You don't have a recording shortcut yet. Set one in Settings to start recording from any app.": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie masz jeszcze skrótu nagrywania. Ustaw go w Ustawieniach, żeby nagrywać z dowolnej aplikacji."
          }
        },
        "eo": {
          "stringUnit": {
            "state": "translated",
            "value": "Vi ankoraŭ ne havas registran klavkombinon. Agordu ĝin en Agordoj por registri el iu ajn aplikaĵo."
          }
        }
      }
    },
