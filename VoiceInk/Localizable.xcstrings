    "Groq, Gemini and Mistral also enhance text; they're listed above.": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Groq, Gemini i Mistral też ulepszają tekst; znajdziesz ich wyżej."
