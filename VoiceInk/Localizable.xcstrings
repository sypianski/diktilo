            "value": "重新转写"
          }
        },
        "eo": {
          "stringUnit": {
            "state": "translated",
            "value": "Transskribi denove"
          }
        }
      }
    },
    "Model Order": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kolejność modeli"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Modellreihenfolge"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "模型顺序"
          }
        },
        "eo": {
          "stringUnit": {
            "state": "translated",
            "value": "Ordo de modeloj"
          }
        }
      }
    },
    "Diktilo starts with the first one. If a model doesn't respond or returns an error, it takes the next one on the list.": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Diktilo zaczyna od pierwszego. Jeśli model nie odpowie albo zwróci błąd, bierze następny z listy."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diktilo beginnt mit dem ersten. Antwortet ein Modell nicht oder meldet einen Fehler, nimmt es das nächste aus der Liste."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Diktilo 从第一个开始。如果某个模型没有响应或返回错误，就使用列表中的下一个。"
          }
        },
        "eo": {
          "stringUnit": {
            "state": "translated",
            "value": "Diktilo komencas per la unua. Se modelo ne respondas aŭ redonas eraron, ĝi prenas la sekvan en la listo."
          }
        }
      }
    },
    "Add Fallback Model": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodaj model zapasowy"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ersatzmodell hinzufügen"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加备用模型"
          }
        },
        "eo": {
          "stringUnit": {
            "state": "translated",
            "value": "Aldoni rezervan modelon"
          }
        }
      }
    },
    "Drag to change the order": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przeciągnij, żeby zmienić kolejność"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zum Ändern der Reihenfolge ziehen"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拖动以更改顺序"
          }
        },
        "eo": {
          "stringUnit": {
            "state": "translated",
            "value": "Trenu por ŝanĝi la ordon"
          }
        }
      }
    },
    "if none of them works": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "gdy żaden nie zadziała"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "wenn keines funktioniert"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如果都不可用"
          }
        },
        "eo": {
          "stringUnit": {
            "state": "translated",
            "value": "se neniu el ili funkcias"
          }
        }
      }
    },
    "The recording stays in History and you get a notification with a Transcribe Again button.": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nagranie zostaje w Historii, a Ty dostajesz powiadomienie z przyciskiem Transkrybuj ponownie."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Aufnahme bleibt im Verlauf, und du erhältst eine Mitteilung mit der Taste „Erneut transkribieren“."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "录音会保留在历史记录中，并会收到带有“重新转写”按钮的通知。"
          }
