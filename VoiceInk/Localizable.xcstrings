    "Show the finish shortcuts of your modes and save targets under the recording bar.": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pokazuje pod paskiem nagrywania skróty kończące Twoich trybów i celów zapisu."
          }
        },
        "eo": {
