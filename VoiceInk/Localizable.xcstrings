        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Filmy i poradniki na YouTube\"}\n\nwith open(\"VoiceInk/Localizable.xcstrings\") as f:\n    data = json.load(f)\n\nstrings = data[\"strings\"]\nadded = 0\n\nfor key, pl_val in pl_map.items():\n    if key not in strings:\n        continue\n    if not pl_val:\n        continue\n    locs = strings[key].setdefault(\"localizations\", {})\n    locs[\"pl\"] = {\"stringUnit\": {\"state\": \"translated\", \"value\": pl_val}}\n    added += 1\n\nwith open(\"VoiceInk/Localizable.xcstrings\", \"w\") as f:\n    json.dump(data, f, ensure_ascii=False, indent=2)\n    f.write(\"\n\")\n\nprint(f\"Done: added {added"
          }
        }
      }
    },
