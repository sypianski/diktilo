        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się nawiązać połączenia z serwerem. Sprawdź połączenie internetowe i spróbuj ponownie."
          }
        },
        "eo": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne eblis atingi la servilon. Kontrolu vian interretan konekton kaj reprovu."
