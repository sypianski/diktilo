    "Use this when you want the quickest possible voice-to-text result. It records with your configured transcription model and pastes the transcript as-is.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwende dies, wenn du möglichst schnell Sprache in Text umwandeln möchtest. Es nimmt mit deinem konfigurierten Transkriptionsmodell auf und fügt das Transkript unverändert ein."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当你想尽快将语音转换为文本时使用此模式。它会使用你配置的转写模型录音，并按原样粘贴转写内容。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Używaj tego, gdy chcesz jak najszybciej zamienić głos na tekst. Nagrywa z użyciem skonfigurowanego modelu transkrypcji i wkleja transkrypt bez zmian."
          }
        },
        "eo": {
          "stringUnit": {
            "state": "translated",
            "value": "Uzu ĉi tion, kiam vi volas kiel eble plej rapidan rezulton de voĉo al teksto. Ĝi registras per via agordita transskriba modelo kaj algluas la transskribon senŝanĝe."
          }
        }
      }
    },
    "Used by \"%@\"": {
      "comment": "A label indicating that a given app is already used by another app. The argument is the name of the app that is already used.",
      "isCommentAutoGenerated": true,
      "localizations": {
