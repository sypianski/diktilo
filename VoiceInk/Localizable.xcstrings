        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diktilo-Sitzungen abgeschlossen"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已完成的 Diktilo 会话"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ukończone sesje Diktilo"
          }
        },
        "eo": {
          "stringUnit": {
            "state": "translated",
            "value": "Finitaj seancoj de Diktilo"
          }
        }
      }
    },
    "Diktilo temporarily uses the clipboard to paste transcription. When enabled, it restores your previous clipboard content after the selected delay. When disabled, the pasted transcription stays on your clipboard.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diktilo nutzt die Zwischenablage vorübergehend zum Einfügen der Transkription. Wenn aktiviert, wird der frühere Inhalt der Zwischenablage nach der gewählten Verzögerung wiederhergestellt. Wenn deaktiviert, bleibt die Transkription in der Zwischenablage."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Diktilo 会临时使用剪贴板来粘贴转写内容。打开后，它会在所选延迟后恢复你之前的剪贴板内容。关闭后，粘贴的转写内容会保留在剪贴板中。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Diktilo tymczasowo używa schowka do wklejania transkrypcji. Gdy włączone, przywraca poprzednią zawartość schowka po wybranym opóźnieniu. Gdy wyłączone, wklejona transkrypcja pozostaje w schowku."
          }
        },
        "eo": {
          "stringUnit": {
            "state": "translated",
            "value": "Diktilo provizore uzas la tondujon por alglui la transskribon. Kiam ŝaltita, ĝi restarigas la antaŭan enhavon de la tondujo post la elektita prokrasto. Kiam malŝaltita, la algluita transskribo restas en la tondujo."
          }
        }
      }
    },
    "Diktilo uses Accessibility to type transcriptions directly into any app.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diktilo verwendet Bedienungshilfen, um Transkriptionen direkt in jede App einzugeben."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Diktilo 使用辅助功能将转写内容直接输入到任何 App 中。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Diktilo używa ułatwień dostępu, aby wpisywać transkrypcje bezpośrednio w dowolnej aplikacji."
          }
        },
        "eo": {
          "stringUnit": {
            "state": "translated",
            "value": "Diktilo uzas Aliireblecon por tajpi transskribojn rekte en ajnan aplikaĵon."
          }
        }
      }
    },
    "Diktilo uses LLMs to enhance transcripts and perform AI actions. Set up an API key before continuing.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diktilo verwendet LLMs, um Transkripte zu verbessern und KI-Aktionen auszuführen. Richte einen API-Schlüssel ein, bevor du fortfährst."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Diktilo 使用大语言模型润色转写记录并执行 AI 操作。请先设置 API 密钥再继续。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Diktilo używa modeli językowych do ulepszania transkryptów i wykonywania działań AI. Skonfiguruj klucz API przed kontynuowaniem."
          }
        },
        "eo": {
          "stringUnit": {
            "state": "translated",
            "value": "Diktilo uzas lingvomodelojn por plibonigi transskribojn kaj plenumi AI-agojn. Agordu API-ŝlosilon antaŭ ol daŭrigi."
          }
        }
      }
    },
    "Diktilo uses your microphone to capture your voice.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diktilo verwendet dein Mikrofon, um deine Stimme aufzunehmen."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Diktilo 使用你的麦克风来采集语音。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Diktilo używa mikrofonu do przechwytywania twojego głosu."
          }
        },
        "eo": {
          "stringUnit": {
            "state": "translated",
            "value": "Diktilo uzas vian mikrofonon por kapti vian voĉon."
          }
        }
      }
    },
    "Diktilo vs. typing by hand": {
      "extractionState": "stale",
      "localizations": {
