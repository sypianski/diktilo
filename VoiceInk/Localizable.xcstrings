    "Diktilo will download NVIDIA's Parakeet model to set up fast local transcription.": {
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diktilo lädt das Parakeet-Modell von NVIDIA herunter, um schnelle lokale Transkription einzurichten."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
