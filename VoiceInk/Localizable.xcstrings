    "Select the text on the screen, tell Diktilo the changes you want, and Diktilo will rewrite the text for you.": {
      "extractionState": "stale",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选中屏幕上的文字，告诉 Diktilo 你想怎么改，它就会替你改写。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zaznacz tekst na ekranie, powiedz Diktilo, jakie zmiany chcesz wprowadzić, a Diktilo przepisze go za ciebie."
          }
        },
        "eo": {
          "stringUnit": {
            "state": "translated",
            "value": "Elektu tekston sur la ekrano, diru al Diktilo la deziratajn ŝanĝojn, kaj Diktilo reverkos la tekston por vi."
          }
        }
      }
    },
    "Share Diktilo with friends or your audience and receive %@ on every referral that upgrades.": {
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Empfiehl Diktilo Freunden oder deinem Publikum und erhalte %@ für jede geworbene Person, die ein Upgrade durchführt."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将 Diktilo 分享给朋友或你的受众，每有一位经你推荐并升级的用户，你都将获得 %@ 的分成。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Udostępnij Diktilo znajomym lub odbiorcom i otrzymaj %@ za każdą poleconą osobę, która kupi subskrypcję."
          }
        },
        "eo": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunhavigu Diktilon kun amikoj aŭ via publiko kaj ricevu %@ por ĉiu rekomendita persono, kiu aĉetas abonon."
          }
        }
      }
    },
    "Start or stop the Diktilo recorder for voice transcription.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diktilo-Aufnahme für Sprachtranskription starten oder stoppen."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "启动或停止 Diktilo 录音器，以进行语音转写。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uruchom lub zatrzymaj rejestrator Diktilo do transkrypcji głosu."
          }
        },
        "eo": {
          "stringUnit": {
            "state": "translated",
            "value": "Komenci aŭ ĉesigi la registrilon de Diktilo por voĉa transskribo."
          }
        }
      }
    },
    "Thank you for using Diktilo": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Danke, dass du Diktilo verwendest"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "感谢你使用 Diktilo"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dziękujemy za korzystanie z Diktilo"
          }
        },
        "eo": {
          "stringUnit": {
            "state": "translated",
            "value": "Dankon pro uzado de Diktilo"
          }
        }
      }
    },
    "The key worked, but Diktilo could not save it securely.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Schlüssel funktioniert, aber Diktilo konnte ihn nicht sicher speichern."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "密钥有效，但 Diktilo 无法安全地存储它。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Klucz zadziałał, ale Diktilo nie mogło go bezpiecznie zapisać."
          }
        },
        "eo": {
          "stringUnit": {
            "state": "translated",
            "value": "La ŝlosilo funkciis, sed Diktilo ne povis konservi ĝin sekure."
          }
        }
      }
    },
    "Toggle Diktilo Recorder": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diktilo-Aufnahme umschalten"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "切换 Diktilo 录音器"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Włącz/wyłącz rejestrator Diktilo"
          }
        },
        "eo": {
          "stringUnit": {
            "state": "translated",
            "value": "Ŝalti/malŝalti la registrilon de Diktilo"
          }
        }
      }
    },
    "Try a few short samples and see how Diktilo works before you start.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Probiere ein paar kurze Beispiele aus und sieh dir an, wie Diktilo funktioniert."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开始之前，先试几个简短的示例，看看 Diktilo 是如何工作的。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wypróbuj kilka krótkich próbek i sprawdź, jak działa Diktilo, zanim zaczniesz."
          }
        },
        "eo": {
          "stringUnit": {
            "state": "translated",
            "value": "Provu kelkajn mallongajn ekzemplojn kaj vidu, kiel Diktilo funkcias, antaŭ ol komenci."
          }
        }
      }
    },
    "Turn your spoken note into a clean email draft with Diktilo.": {
      "extractionState": "stale",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用 Diktilo 把你的口述整理成整洁的邮件草稿。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zamień mówioną notatkę w gotowy szkic e-maila za pomocą Diktilo."
          }
        },
        "eo": {
          "stringUnit": {
            "state": "translated",
            "value": "Igu vian parolitan noton pura retpoŝta malneto per Diktilo."
          }
        }
      }
    },
    "Use Diktilo now.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diktilo jetzt nutzen."
          }
        },
        "zh-Hans": {
          "stringUnit": {
