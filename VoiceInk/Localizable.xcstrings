    "Off while “Copy Every Transcription to Clipboard” is on under Pasting and Clipboard.": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wyłączone, gdy w sekcji Wklejanie i schowek jest włączone „Kopiuj każdą transkrypcję do schowka”."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aus, solange unter „Einfügen und Zwischenablage“ „Jede Transkription in die Zwischenablage kopieren“ aktiv ist."
          }
        },
        "zh-Hans": {
          "stringUnit": {
