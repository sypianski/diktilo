    "Diktilo is private by default. No data leaves your device unless you opt in.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diktilo ist standardmäßig privat. Keine Daten verlassen dein Gerät, sofern du dem nicht zustimmst."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Diktilo 默认保护隐私。除非你主动选择，否则任何数据都不会离开你的设备。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Diktilo jest domyślnie prywatne. Żadne dane nie opuszczają urządzenia, jeśli sam tego nie wybierzesz."
          }
        },
        "eo": {
          "stringUnit": {
            "state": "translated",
            "value": "Diktilo estas implicite privata. Neniuj datumoj forlasas vian aparaton, krom se vi mem elektas tion."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Diktilo és privat per defecte. Cap dada surt del dispositiu tret que tu ho decideixis."
          }
        }
      }
    },
    "Diktilo Modes": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diktilo-Modi"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Diktilo 模式"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryby Diktilo"
          }
        },
        "eo": {
          "stringUnit": {
            "state": "translated",
            "value": "Reĝimoj de Diktilo"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Modes de Diktilo"
          }
        }
      }
    },
    "Diktilo modes include Dictation, Enhance, Email, Assistant, Rewrite, Ask, Summarize, and Translate.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diktilo-Modi umfassen Diktat, Verbesserung, E-Mail, Assistent, Umschreiben, Fragen, Zusammenfassen und Übersetzen."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Diktilo 的模式包括听写、润色、邮件、助手、改写、提问、总结和翻译。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryby Diktilo obejmują: Dyktowanie, Ulepszanie, E-mail, Asystent, Przepisywanie, Pytaj, Podsumuj i Tłumacz."
          }
        },
        "eo": {
          "stringUnit": {
            "state": "translated",
            "value": "La reĝimoj de Diktilo inkluzivas: Diktado, Plibonigo, Retpoŝto, Asistanto, Reverkado, Demandi, Resumi kaj Traduki."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Els modes de Diktilo inclouen Dictat, Millorar, Correu, Assistent, Reescriure, Preguntar, Resumir i Traduir."
          }
        }
      }
    },
    "Diktilo progress": {
      "comment": "A placeholder text that is displayed when the user has not recorded any VoiceInk sessions.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diktilo-Fortschritt"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Diktilo 进度"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Postęp w Diktilo"
          }
        },
        "eo": {
          "stringUnit": {
            "state": "translated",
            "value": "Progreso en Diktilo"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "progrés a Diktilo"
          }
        }
      }
    },
    "Diktilo reads visible screen content to improve the accuracy of transcripts.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diktilo liest sichtbare Bildschirminhalte, um die Genauigkeit der Transkripte zu verbessern."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Diktilo 会读取屏幕上的可见内容，以提高转写的准确性。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Diktilo odczytuje widoczną zawartość ekranu, aby poprawić dokładność transkryptów."
          }
        },
        "eo": {
          "stringUnit": {
            "state": "translated",
            "value": "Diktilo legas la videblan enhavon de la ekrano por plibonigi la precizecon de transskriboj."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Diktilo llegeix el contingut visible de la pantalla per millorar la precisió de les transcripcions."
          }
        }
      }
    },
    "Diktilo recorder dismissed": {
