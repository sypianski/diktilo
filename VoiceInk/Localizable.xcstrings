    "Environment variables available: VOICEINK_SYSTEM_PROMPT, VOICEINK_USER_PROMPT, VOICEINK_FULL_PROMPT. Diktilo also writes VOICEINK_FULL_PROMPT to stdin for every command.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verfügbare Umgebungsvariablen: VOICEINK_SYSTEM_PROMPT, VOICEINK_USER_PROMPT, VOICEINK_FULL_PROMPT. Diktilo schreibt außerdem VOICEINK_FULL_PROMPT für jeden Befehl nach stdin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可用的环境变量：VOICEINK_SYSTEM_PROMPT、VOICEINK_USER_PROMPT、VOICEINK_FULL_PROMPT。Diktilo 还会在每次执行命令时将 VOICEINK_FULL_PROMPT 写入 stdin。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dostępne zmienne środowiskowe: VOICEINK_SYSTEM_PROMPT, VOICEINK_USER_PROMPT, VOICEINK_FULL_PROMPT. Diktilo zapisuje również VOICEINK_FULL_PROMPT do stdin dla każdego polecenia."
          }
        },
        "eo": {
          "stringUnit": {
            "state": "translated",
            "value": "Disponeblaj medivariabloj: VOICEINK_SYSTEM_PROMPT, VOICEINK_USER_PROMPT, VOICEINK_FULL_PROMPT. Diktilo ankaŭ skribas VOICEINK_FULL_PROMPT al stdin por ĉiu komando."
          }
        }
      }
    },
