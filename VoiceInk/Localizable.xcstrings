    "You’re building momentum this week. Keep it going.": {
      "comment": "A message displayed in the dashboard when the user has been active for at least one day in the last week.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du baust diese Woche Schwung auf. Mach weiter."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你本周正在积累进展。继续保持。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Budujesz tempo w tym tygodniu. Tak trzymaj."
          }
        },
        "eo": {
          "stringUnit": {
