    "Diktilo modes include Dictation, Enhance, Email, Assistant, Rewrite, Ask, Summarize, and Translate.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diktilo-Modi umfassen Diktat, Verbesserung, E-Mail, Assistent, Umschreiben, Fragen, Zusammenfassen und Übersetzen."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Diktilo 的模式包括听写、润色、邮件、助手、改写、提问、总结和翻译。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
