    "Diktilo is private by default": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diktilo ist standardmäßig privat"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Diktilo 默认保护隐私"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Diktilo jest domyślnie prywatne"
          }
        },
        "eo": {
