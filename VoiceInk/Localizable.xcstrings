    "This can happen due to an issue with the audio recording or insufficient system resources. Please try again, or restart the app.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dies kann durch ein Problem mit der Audioaufnahme oder durch unzureichende Systemressourcen auftreten. Bitte versuche es erneut oder starte die App neu."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这可能是由录音问题或系统资源不足导致的。请重试，或重新启动 App。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Może to wynikać z problemu z nagrywaniem audio lub niewystarczających zasobów systemowych. Spróbuj ponownie lub uruchom aplikację ponownie."
          }
        },
        "eo": {
          "stringUnit": {
            "state": "translated",
            "value": "Tio povas okazi pro problemo pri la sonregistrado aŭ nesufiĉaj sistemaj rimedoj. Bonvolu reprovi aŭ restartigi la aplikaĵon."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Això pot passar per un problema amb l'enregistrament d'àudio o per manca de recursos del sistema. Torna-ho a provar o reinicia l'app."
          }
        }
      }
    },
