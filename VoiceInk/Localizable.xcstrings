            "value": "Ŝalti ĉi tiun reĝimon"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Activar aquest mode"
          }
        }
      }
    },
    "Pasting and Clipboard": {
      "localizations": {
        "pl": {
          "stringUnit": {
