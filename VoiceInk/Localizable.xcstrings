            "value": "Sistemaj informoj"
          }
        }
      }
    },
    "Diktilo transcribes with a local model or through an outside provider with an API key.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diktilo transkribiert mit einem lokalen Modell oder über einen externen Anbieter mit API-Schlüssel."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Diktilo transkrybuje modelem lokalnym albo przez zewnętrznego dostawcę z kluczem API."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Diktilo 使用本地模型，或通过带 API 密钥的外部提供商进行转写。"
          }
        },
        "eo": {
          "stringUnit": {
            "state": "translated",
            "value": "Diktilo transskribas per loka modelo aŭ per ekstera provizanto kun API-ŝlosilo."
          }
        }
      }
    },
    "All models failed (%@)": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wszystkie modele zawiodły (%@)"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle Modelle sind fehlgeschlagen (%@)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所有模型均失败（%@）"
          }
        },
        "eo": {
